# ----------------------------------------------------------------
# JIRA Cloud connection  (flahca.atlassian.net)
# ----------------------------------------------------------------

# Base URL of your JIRA Cloud instance (no trailing slash)
JIRA_BASE_URL=https://flahca.atlassian.net

# Your Atlassian account email
JIRA_EMAIL=your.email@flahca.myflorida.com

# API token — generate at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# ----------------------------------------------------------------
# RFC query settings
# ----------------------------------------------------------------

# Saved JIRA filter ID to use as the calendar source.
# Dashboard gadget "Rescheduled RFCs" uses filter 11588.
# Leave blank to fall back to JQL built from JIRA_PROJECTS.
JIRA_FILTER_ID=11588

# Comma-separated JIRA project keys (only used when JIRA_FILTER_ID is blank).
JIRA_PROJECTS=

# JIRA field ID that holds the implementation / due date.
# Use "duedate" (standard) or a custom field ID like "customfield_10015".
JIRA_IMPL_DATE_FIELD=duedate

# ----------------------------------------------------------------
# SharePoint embedding
# ----------------------------------------------------------------

# CSP frame-ancestors value — allows SharePoint to embed this app.
# Use your tenant origin, e.g. https://contoso.sharepoint.com
SHAREPOINT_ORIGIN=https://*.sharepoint.com

# ----------------------------------------------------------------
# App settings
# ----------------------------------------------------------------

PORT=5003
