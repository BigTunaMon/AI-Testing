# ----------------------------------------------------------------
# JIRA Server / Data Center connection
# ----------------------------------------------------------------

# Base URL of your JIRA instance (no trailing slash)
JIRA_BASE_URL=https://jira.yourcompany.com

# --- Authentication: choose ONE method ---

# Option A – Personal Access Token (recommended, JIRA 8.14+)
JIRA_PAT=your_personal_access_token_here

# Option B – Basic auth (username + password)
# JIRA_USERNAME=your_username
# JIRA_PASSWORD=your_password

# ----------------------------------------------------------------
# RFC query settings
# ----------------------------------------------------------------

# Comma-separated JIRA project keys to restrict the query.
# Leave blank to search ALL projects for issuetype = RFC.
JIRA_PROJECTS=

# JIRA field ID that holds the implementation / due date.
# Use "duedate" (standard) or a custom field ID like "customfield_10015".
JIRA_IMPL_DATE_FIELD=duedate

# ----------------------------------------------------------------
# SharePoint embedding
# ----------------------------------------------------------------

# CSP frame-ancestors value — allows SharePoint to embed this app.
# Use your tenant origin, e.g. https://contoso.sharepoint.com
SHAREPOINT_ORIGIN=https://*.sharepoint.com

# ----------------------------------------------------------------
# App settings
# ----------------------------------------------------------------

PORT=5003
