# AHCA Documentation Chatbot – Environment Variables
# Copy this file to .env and fill in your values.

# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: set a fixed Flask secret key for stable sessions across restarts.
# If omitted, a random key is generated on startup (sessions reset on restart).
FLASK_SECRET_KEY=change-me-to-a-long-random-string
