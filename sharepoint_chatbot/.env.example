# ── Azure AD App Registration ──────────────────────────────────────────────────
# Create an App Registration in https://portal.azure.com → Azure Active Directory
# → App registrations → New registration (Public client / native)
#
# Required delegated API permissions (grant admin consent):
#   Microsoft Graph → Sites.Read.All
#   Microsoft Graph → Files.Read.All
#
# Enable ROPC: Authentication → Advanced settings → Allow public client flows → Yes
#
# NOTE: ROPC does NOT work for accounts with MFA enforced.

SP_TENANT_ID=your-azure-tenant-id-here
SP_CLIENT_ID=your-azure-app-client-id-here

# SharePoint user credentials (no MFA on this account)
SP_USERNAME=user@flahca.onmicrosoft.com
SP_PASSWORD=your-sharepoint-password-here

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Flask ──────────────────────────────────────────────────────────────────────
# Set to a long random string in any non-local environment
FLASK_SECRET_KEY=change-this-to-a-long-random-string
